{
  "name": "@mcp-toolkit/core",
  "version": "0.0.1",
  "private": true,
  "description": "Shared building blocks for the MCP Toolkit servers: auth helpers, audit logger, structured logger, error types.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./audit": {
      "import": "./dist/audit.js",
      "types": "./dist/audit.d.ts"
    },
    "./auth": {
      "import": "./dist/auth.js",
      "types": "./dist/auth.d.ts"
    },
    "./logger": {
      "import": "./dist/logger.js",
      "types": "./dist/logger.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "better-sqlite3": "11.8.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "22.10.5"
  }
}
