{
  "name": "@mcp-toolkit/core",
  "version": "0.0.1",
  "private": true,
  "description": "Shared building blocks for the MCP Toolkit servers: auth, audit (SQLite + Postgres), logger, runMcpServer helper, replay CLI.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./audit": {
      "import": "./dist/audit.js",
      "types": "./dist/audit.d.ts"
    },
    "./auth": {
      "import": "./dist/auth.js",
      "types": "./dist/auth.d.ts"
    },
    "./logger": {
      "import": "./dist/logger.js",
      "types": "./dist/logger.d.ts"
    }
  },
  "bin": {
    "atif-mcp-replay": "./dist/replay.js"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.0.4",
    "better-sqlite3": "11.8.1",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "22.10.5",
    "@types/pg": "8.11.10"
  }
}
